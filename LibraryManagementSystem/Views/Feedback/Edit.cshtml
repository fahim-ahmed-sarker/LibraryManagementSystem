@model LibraryManagementSystem.Models.Feedback

@{
    ViewData["Title"] = "Edit Review";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-body">

                    <h2 class="mb-4">
                        Edit Review
                    </h2>

                    <h4>@Model.Book?.Title</h4>

                    <p class="text-muted">
                        Update your rating and comment.
                    </p>

                    <hr />

                    <form asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.FeedbackID" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label class="form-label"
                                   for="rating">
                                Rating
                            </label>

                            <select id="rating"
                                    name="rating"
                                    class="form-select"
                                    required>

                                @for (int rating = 5; rating >= 1; rating--)
                                {
                                    <option value="@rating"
                                            selected="@(Model.Rating == rating)">
                                        @rating - @(rating == 5 ? "Excellent" : rating == 4 ? "Very good" : rating == 3 ? "Good" : rating == 2 ? "Fair" : "Poor")
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label"
                                   for="comment">
                                Comment
                            </label>

                            <textarea id="comment"
                                      name="comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="1000">@Model.Comment</textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Review
                        </button>

                        <a asp-action="MyFeedback"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}