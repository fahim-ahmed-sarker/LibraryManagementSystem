@model IEnumerable<LibraryManagementSystem.Models.BorrowTransaction>

@{
    ViewData["Title"] = "Transaction Management";
    var selectedStatus = ViewBag.Status as string;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>Transaction Management</h1>

        <a asp-controller="Fine"
           asp-action="Index"
           class="btn btn-warning">
            Manage Fines
        </a>

    </div>

    <!-- Status Filter -->

    <form asp-action="Manage"
          method="get"
          class="row g-2 mb-4">

        <div class="col-md-4">

            <select name="status"
                    class="form-select">

                <option value="">
                    All Transactions
                </option>

                <option value="Borrowed"
                        selected="@(selectedStatus == "Borrowed")">
                    Borrowed
                </option>

                <option value="Returned"
                        selected="@(selectedStatus == "Returned")">
                    Returned
                </option>

                <option value="Overdue"
                        selected="@(selectedStatus == "Overdue")">
                    Overdue
                </option>

            </select>

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary">
                Filter
            </button>

        </div>

    </form>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No transactions found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>

                    <tr>
                        <th>Member</th>
                        <th>Book</th>
                        <th>Borrow Date</th>
                        <th>Due Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th>Renewals</th>
                        <th>Fine</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var transaction in Model)
                    {
                        <tr>

                            <td>
                                @transaction.Member?.Name
                                <br />
                                <small class="text-muted">
                                    @transaction.Member?.Email
                                </small>
                            </td>

                            <td>
                                @transaction.Book?.Title
                            </td>

                            <td>
                                @transaction.BorrowDate
                                .ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @transaction.DueDate
                                .ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @(transaction.ReturnDate?
                                    .ToString("dd MMM yyyy") ?? "-")
                            </td>

                            <td>

                                @if (transaction.Status == "Borrowed")
                                {
                                    <span class="badge bg-primary">
                                        Borrowed
                                    </span>
                                }
                                else if (transaction.Status == "Overdue")
                                {
                                    <span class="badge bg-danger">
                                        Overdue
                                    </span>
                                }
                                else if (transaction.Status == "Returned")
                                {
                                    <span class="badge bg-success">
                                        Returned
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @transaction.Status
                                    </span>
                                }

                            </td>

                            <td>
                                @transaction.RenewalCount
                            </td>

                            <td>

                                @if (transaction.Fine != null)
                                {
                                    <span>
                                        @transaction.Fine.Amount.ToString("C")
                                    </span>

                                    @if (transaction.Fine.IsPaid)
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unpaid
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Fine
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>