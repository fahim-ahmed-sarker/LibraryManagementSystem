@{
    ViewData["Title"] = "Home";

    var newArrivals =
        ViewBag.NewArrivals
        as List<LibraryManagementSystem.Models.Book>
        ?? new List<LibraryManagementSystem.Models.Book>();

    var mostBorrowed =
        ViewBag.MostBorrowed
        as List<LibraryManagementSystem.Models.Book>
        ?? new List<LibraryManagementSystem.Models.Book>();

    var availableBooks =
        ViewBag.AvailableBooks
        as List<LibraryManagementSystem.Models.Book>
        ?? new List<LibraryManagementSystem.Models.Book>();

    var recommendedBooks =
        ViewBag.RecommendedBooks
        as List<LibraryManagementSystem.Models.Book>
        ?? new List<LibraryManagementSystem.Models.Book>();
}


<!-- ========================================== -->
<!-- HERO SECTION -->
<!-- ========================================== -->

<div class="hero-section mb-5">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <h1 class="display-4 fw-bold mb-4">
                    City Knowledge Library
                </h1>

                <p class="lead mb-4">
                    A considered place to discover new ideas,
                    borrow confidently, and keep your reading life organised.
                </p>

                     <a asp-controller="Book"
                         asp-action="Index"
                         class="btn btn-light btn-lg">
                          Browse Catalogue
                          <i class="bi bi-arrow-up-right ms-2"
                              aria-hidden="true"></i>
                     </a>

            </div>

            <div class="col-lg-5">

                <div class="hero-library-panel">
                    <div class="hero-panel-topline">
                        <span>EST. 2026</span>
                        <i class="bi bi-arrow-up-right"
                           aria-hidden="true"></i>
                    </div>

                    <img src="~/images/logo/library-logo.png"
                         class="hero-logo"
                         alt="" />

                    <div>
                        <p class="hero-panel-title">
                            Read further.
                        </p>
                        <p class="hero-panel-copy">
                            Find your next perspective among the shelves.
                        </p>
                        <a asp-controller="Book"
                           asp-action="Index"
                           class="hero-panel-link">
                            Open catalogue
                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>
                        </a>
                    </div>

                    <div class="hero-panel-footer">
                        <div>
                            <strong>@ViewBag.TotalTitles</strong>
                            <span>titles</span>
                        </div>
                        <div>
                            <strong>@ViewBag.AvailableTitleCount</strong>
                            <span>available</span>
                        </div>
                        <div>
                            <strong>@ViewBag.GenreCount</strong>
                            <span>genres</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>


<div class="container">


    <!-- ========================================== -->
    <!-- NEW ARRIVALS -->
    <!-- ========================================== -->

    <section class="mb-5">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h2>
                     <i class="bi bi-stars section-icon"
                         aria-hidden="true"></i>
                     New Arrivals
            </h2>

            <a asp-controller="Book"
               asp-action="Index"
               class="btn btn-outline-primary">
                View All
            </a>

        </div>


        <div class="shelf-toolbar">
            <div></div>
            <div class="shelf-controls">
                <button type="button"
                        class="shelf-arrow"
                        data-shelf-target="new-arrivals-shelf"
                        data-shelf-direction="-1"
                        aria-label="Previous new arrivals">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>
                <button type="button"
                        class="shelf-arrow"
                        data-shelf-target="new-arrivals-shelf"
                        data-shelf-direction="1"
                        aria-label="Next new arrivals">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="new-arrivals-shelf" class="row book-shelf-row">

            @if (!newArrivals.Any())
            {
                <div class="col-12">

                    <div class="alert alert-info">
                        No books have been added yet.
                    </div>

                </div>
            }
            else
            {
                @foreach (var book in newArrivals)
                {
                    <div class="col-md-4 col-lg-2 mb-4 book-shelf-item">

                        <div class="card h-100 shadow-sm home-book-card">

                            @if (!string.IsNullOrEmpty(
                                book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     class="card-img-top home-book-cover"
                                     style="height:220px;
                                            object-fit:cover;"
                                     alt="@book.Title" />
                            }
                            else
                            {
                                <div class="bg-light text-center
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="height:220px;">

                                                <i class="bi bi-book placeholder-icon"
                                                    aria-hidden="true"></i>

                                </div>
                            }

                            <div class="card-body">

                                <h6 class="card-title">
                                    @book.Title
                                </h6>

                                <p class="book-card-author mb-1">
                                    <strong>Author:</strong> @book.Author
                                </p>

                                <p class="book-card-genre mb-2">
                                    <strong>Genre:</strong> @book.Genre
                                </p>

                                <p class="book-card-status mb-0">
                                    <strong>Status:</strong>
                                    <span class="badge status-badge status-@book.AvailabilityStatus.ToLowerInvariant()">
                                        @book.AvailabilityStatus
                                    </span>
                                </p>

                            </div>

                            <div class="card-footer bg-white">

                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@book.BookID"
                                   class="btn btn-sm
                                          btn-primary w-100">
                                    Details
                                </a>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </section>


    <!-- ========================================== -->
    <!-- MOST BORROWED -->
    <!-- ========================================== -->

    <section class="mb-5 section-divider">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h2>
                     <i class="bi bi-fire section-icon"
                         aria-hidden="true"></i>
                     Most Borrowed Books
            </h2>

        </div>


        <div class="shelf-toolbar">
            <div></div>
            <div class="shelf-controls">
                <button type="button" class="shelf-arrow"
                        data-shelf-target="most-borrowed-shelf"
                        data-shelf-direction="-1"
                        aria-label="Previous most borrowed books">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="shelf-arrow"
                        data-shelf-target="most-borrowed-shelf"
                        data-shelf-direction="1"
                        aria-label="Next most borrowed books">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="most-borrowed-shelf" class="row book-shelf-row">

            @if (!mostBorrowed.Any())
            {
                <div class="col-12">

                    <div class="alert alert-info">
                        No borrowing data available yet.
                    </div>

                </div>
            }
            else
            {
                @foreach (var book in mostBorrowed)
                {
                    <div class="col-md-4 col-lg-2 mb-4 book-shelf-item">

                        <div class="card h-100 shadow-sm home-book-card">

                            @if (!string.IsNullOrEmpty(
                                book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     class="card-img-top home-book-cover"
                                     style="height:220px;
                                            object-fit:cover;"
                                     alt="@book.Title" />
                            }
                            else
                            {
                                <div class="bg-light text-center
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="height:220px;">

                                                <i class="bi bi-book placeholder-icon"
                                                    aria-hidden="true"></i>

                                </div>
                            }

                            <div class="card-body">

                                <h6 class="card-title">
                                    @book.Title
                                </h6>

                                <p class="book-card-author mb-1">
                                    <strong>Author:</strong> @book.Author
                                </p>

                                <p class="book-card-genre mb-2">
                                    <strong>Genre:</strong> @book.Genre
                                </p>

                                <p class="book-card-status mb-0">
                                    <strong>Status:</strong>
                                    <span class="badge status-badge status-@book.AvailabilityStatus.ToLowerInvariant()">
                                        @book.AvailabilityStatus
                                    </span>
                                </p>

                            </div>

                            <div class="card-footer bg-white">

                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@book.BookID"
                                   class="btn btn-sm
                                          btn-primary w-100">
                                    Details
                                </a>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </section>


    <!-- ========================================== -->
    <!-- RECOMMENDED -->
    <!-- ========================================== -->

    <section class="mb-5 section-divider">

        <h2 class="mb-3">
                <i class="bi bi-compass section-icon"
                    aria-hidden="true"></i>
                Recommended Books
        </h2>

        <div class="shelf-toolbar">
            <div></div>
            <div class="shelf-controls">
                <button type="button" class="shelf-arrow"
                        data-shelf-target="recommended-shelf"
                        data-shelf-direction="-1"
                        aria-label="Previous recommended books">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="shelf-arrow"
                        data-shelf-target="recommended-shelf"
                        data-shelf-direction="1"
                        aria-label="Next recommended books">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="recommended-shelf" class="row book-shelf-row">

            @if (!recommendedBooks.Any())
            {
                <div class="col-12">

                    <div class="alert alert-info">
                        Recommendations will appear here
                        as books and ratings are added.
                    </div>

                </div>
            }
            else
            {
                @foreach (var book in recommendedBooks)
                {
                    <div class="col-md-4 col-lg-2 mb-4 book-shelf-item">

                        <div class="card h-100 shadow-sm home-book-card">

                            @if (!string.IsNullOrEmpty(
                                book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     class="card-img-top home-book-cover"
                                     style="height:220px;
                                            object-fit:cover;"
                                     alt="@book.Title" />
                            }
                            else
                            {
                                <div class="bg-light text-center
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="height:220px;">

                                                <i class="bi bi-book placeholder-icon"
                                                    aria-hidden="true"></i>

                                </div>
                            }

                            <div class="card-body">

                                <h6 class="card-title">
                                    @book.Title
                                </h6>

                                <p class="book-card-author mb-1">
                                    <strong>Author:</strong> @book.Author
                                </p>

                                <p class="book-card-genre mb-2">
                                    <strong>Genre:</strong> @book.Genre
                                </p>

                                <p class="book-card-status mb-0">
                                    <strong>Status:</strong>
                                    <span class="badge status-badge status-@book.AvailabilityStatus.ToLowerInvariant()">
                                        @book.AvailabilityStatus
                                    </span>
                                </p>

                                <div class="mt-2">
                                                <i class="bi bi-award me-1"
                                                    aria-hidden="true"></i>
                                                Recommended
                                </div>

                            </div>

                            <div class="card-footer bg-white">

                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@book.BookID"
                                   class="btn btn-sm
                                          btn-primary w-100">
                                    Details
                                </a>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </section>


    <!-- ========================================== -->
    <!-- AVAILABLE BOOKS -->
    <!-- ========================================== -->

    <section class="mb-5 section-divider">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h2>
                     <i class="bi bi-check2-circle section-icon"
                         aria-hidden="true"></i>
                     Currently Available
            </h2>

            <a asp-controller="Book"
               asp-action="Index"
               class="btn btn-outline-success">
                Browse Catalogue
            </a>

        </div>


        <div class="shelf-toolbar">
            <div></div>
            <div class="shelf-controls">
                <button type="button" class="shelf-arrow"
                        data-shelf-target="available-books-shelf"
                        data-shelf-direction="-1"
                        aria-label="Previous available books">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="shelf-arrow"
                        data-shelf-target="available-books-shelf"
                        data-shelf-direction="1"
                        aria-label="Next available books">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="available-books-shelf" class="row book-shelf-row">

            @if (!availableBooks.Any())
            {
                <div class="col-12">

                    <div class="alert alert-warning">
                        No books are currently available.
                    </div>

                </div>
            }
            else
            {
                @foreach (var book in availableBooks)
                {
                    <div class="col-md-6 col-lg-4 mb-4 book-shelf-item">

                        <div class="card h-100 shadow-sm home-book-card available-book-card">

                            @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     class="card-img-top home-book-cover"
                                     alt="@book.Title" />
                            }
                            else
                            {
                                <div class="bg-light text-center d-flex align-items-center justify-content-center"
                                     style="height:220px;">
                                    <i class="bi bi-book placeholder-icon"
                                       aria-hidden="true"></i>
                                </div>
                            }

                            <div class="card-body">

                                <h6 class="card-title">
                                    @book.Title
                                </h6>

                                <p class="book-card-author mb-1">
                                    <strong>Author:</strong> @book.Author
                                </p>

                                <p class="book-card-genre mb-2">
                                    <strong>Genre:</strong> @book.Genre
                                </p>

                                <p class="book-card-status mb-0">
                                    <strong>Status:</strong>
                                    <span class="badge status-badge status-@book.AvailabilityStatus.ToLowerInvariant()">
                                        @book.AvailabilityStatus
                                    </span>
                                </p>

                            </div>

                            <div class="card-footer bg-white">
                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@book.BookID"
                                   class="btn btn-sm btn-primary w-100">
                                    Details
                                </a>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </section>


    <!-- ========================================== -->
    <!-- GROUP DETAILS -->
    <!-- ========================================== -->

    <section class="mb-5">

        <h2 class="mb-3">
                <i class="bi bi-people section-icon"
                    aria-hidden="true"></i>
                Group Details
        </h2>

        <div class="table-responsive">

            <table class="table table-bordered
                          table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>
                            Student ID
                        </th>

                        <th>
                            Full Name
                        </th>

                        <th>
                            Responsibility
                        </th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>
                            <strong>20029294</strong>
                        </td>

                        <td style="white-space: normal;">
                            <strong>Fahim Ahmed Sarker</strong>
                        </td>

                        <td>
                            <strong>Librarian Module &amp; Documentation:</strong> Librarian registration and authentication, library profile management, book catalogue CRUD, book search and details, book cover upload, borrowing configuration, transaction management, fine management, feedback moderation, reports, librarian dashboard, system documentation and user manual.
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <strong>20030827</strong>
                        </td>

                        <td style="white-space: normal;">
                            <strong>Mohammad Mumtahin</strong>
                        </td>

                        <td>
                            <strong>Member Module &amp; Unit Testing:</strong> Member registration and authentication, book browsing and searching, book details and availability, borrowing, returning, reservation, loan renewal, borrowing history, fines, feedback and ratings, member dashboard, and unit testing of core borrowing and transaction functionality.
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>

</div>