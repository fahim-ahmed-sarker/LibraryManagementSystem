@model IEnumerable<LibraryManagementSystem.Controllers.MostPopularBookViewModel>

@{
    ViewData["Title"] = "Most Popular Books";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <h1>
            🔥 Most Popular Books
        </h1>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Reports
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No book borrowing data is available.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered
                          table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Rank</th>
                        <th>Book</th>
                        <th>Author</th>
                        <th>Genre</th>
                        <th>Borrowings</th>
                        <th>Average Rating</th>
                    </tr>

                </thead>

                <tbody>

                @{
                    int rank = 1;
                }

                @foreach (var book in Model)
                {
                    <tr>

                        <td>
                            @rank
                        </td>

                        <td>
                            <a asp-controller="Book"
                               asp-action="Details"
                               asp-route-id="@book.BookID">

                                @book.Title

                            </a>
                        </td>

                        <td>
                            @book.Author
                        </td>

                        <td>
                            @book.Genre
                        </td>

                        <td>
                            <strong>
                                @book.BorrowCount
                            </strong>
                        </td>

                        <td>

                            @if (book.AverageRating > 0)
                            {
                                <span>
                                    ⭐
                                    @book.AverageRating
                                        .ToString("0.0") / 5
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No ratings
                                </span>
                            }

                        </td>

                    </tr>

                    rank++;
                }

                </tbody>

            </table>

        </div>
    }

</div>