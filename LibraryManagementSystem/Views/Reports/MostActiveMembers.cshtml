@model IEnumerable<LibraryManagementSystem.Controllers.MostActiveMemberViewModel>

@{
    ViewData["Title"] = "Most Active Members";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <h1>
                <i class="bi bi-people me-2"
                    aria-hidden="true"></i>
                Most Active Members
        </h1>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Reports
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No member borrowing data is available.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered
                          table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Rank</th>
                        <th>Member</th>
                        <th>Email</th>
                        <th>Total Borrowings</th>
                    </tr>

                </thead>

                <tbody>

                @{
                    int rank = 1;
                }

                @foreach (var member in Model)
                {
                    <tr>

                        <td>
                            @rank
                        </td>

                        <td>
                            @member.MemberName
                        </td>

                        <td>
                            @member.Email
                        </td>

                        <td>
                            <strong>
                                @member.BorrowCount
                            </strong>
                        </td>

                    </tr>

                    rank++;
                }

                </tbody>

            </table>

        </div>
    }

</div>